{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "arcade-board-api",
	"main": "src/worker.js",
	"compatibility_date": "2026-11-01",
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "arcade-board",
      "database_id": "ac8b118a-5665-4032-8771-448ceedfd5f5",
      "migrations_dir": "migrations"
		}
	],
  "durable_objects": {
    "bindings": [
      { "name": "AUTH_RATE_LIMITER", "class_name": "AuthRateLimiter" }
    ]
  },
  "migrations": [
    { "tag": "v1-auth-rate-limiter", "new_sqlite_classes": ["AuthRateLimiter"] }
  ],
  "secrets": {
    "required": ["SESSION_SECRET", "ADDRESS_ENCRYPTION_KEY"]
  },
	"vars": {
		"ALLOWED_ORIGINS": "https://arcade.nextarcade.workers.dev,https://julie9578.github.io,https://visionai-arcade.pages.dev"
	}
}